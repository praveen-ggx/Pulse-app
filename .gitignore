dist-test-bundle/

# empty monorepo stubs
apps/web/.next/

# Playwright MCP local cache/state
.playwright-mcp/

# Local client agreement PDFs / rate sheets (not for git)
docs/warehouse-contracts/

# Supabase log exports (debugging artifacts, not source)
supabase_logs*.csv

# OpenClaw (local agent workspace — not app source)
.openclaw/
AGENTS.md
HEARTBEAT.md
IDENTITY.md
SOUL.md
TOOLS.md
USER.md

# Playwright E2E credentials (keep OUT of the root .env*.local pattern —
# Metro bundles those and fails on non-JS syntax). Example file stays tracked.
e2e/.env.e2e

# QA scratch: captured permission baselines / restore targets for real members.
# Contains member UUIDs and permission counts — no credentials, but not ours to commit.
e2e/.qa/

# Local Netlify folder
.netlify
